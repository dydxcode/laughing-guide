# URL Adsterra Smartlink resmi dari akun Adsterra pemilik website.
# Kosongkan untuk menonaktifkan iklan (tidak ada elemen iklan yang dirender).
# Harus berupa URL HTTPS. Jangan isi dengan URL tebakan atau milik publisher lain.
# Nilai ini terlihat di HTML publik, jadi bukan tempat untuk password/token.
# Isi di Vercel: Settings → Environment Variables, lalu redeploy.
NEXT_PUBLIC_ADSTERRA_SMARTLINK_URL=

# Variabel berikut disediakan otomatis oleh Vercel (tidak perlu diisi manual):
#   VERCEL_ENV = production | preview | development
# Nilai ini dipakai di src/app/layout.tsx agar Preview Deployment
# mendapat meta noindex, sedangkan Production tetap bisa diindeks.
